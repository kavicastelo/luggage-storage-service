# =====================================================================
# Luggage Storage Marketplace — Demo API Environment Configuration
# Target Runtime: AWS EC2 Ubuntu / Node.js 22 LTS / Fastify
# =====================================================================

NODE_ENV=production
APP_ENV=demo
PORT=3020
HOST=127.0.0.1
LOG_LEVEL=info

# ---------------------------------------------------------------------
# Supabase PostgreSQL Database (IPv4 Session Pooler)
# ---------------------------------------------------------------------
# Use the session pooler URI on port 5432 (aws-0-<region>.pooler.supabase.com:5432)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
MIGRATION_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_MAX_CONNECTIONS=10

# Strict TLS Certificate Verification with Supabase Root CA
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA=certificates/supabase-root-ca.crt

# ---------------------------------------------------------------------
# Security, Tokens & Cryptography
# ---------------------------------------------------------------------
# Minimum 32-character secrets required for demo/production
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_chars
COOKIE_SECRET=replace_with_secure_random_cookie_secret_min_32_chars
PAYOUT_ENCRYPTION_KEY=replace_with_secure_random_payout_key_min_32_chars
RATE_LIMIT_HASH_SECRET=replace_with_secure_random_rate_limit_secret_32_chars
DB_IDENTITY_SECRET=replace_with_secure_random_db_identity_secret_min_32_chars
DB_IDENTITY_KEY_ID=active

# ---------------------------------------------------------------------
# CORS & URLs
# ---------------------------------------------------------------------
# Explicit trusted origins separated by comma (no wildcard in production)
CORS_ORIGIN=https://demo-api.yourdomain.com,http://localhost:5173
APP_PUBLIC_URL=https://demo-api.yourdomain.com
API_PREFIX=/api/v1

# ---------------------------------------------------------------------
# Email Provider (Demo/Testing)
# ---------------------------------------------------------------------
EMAIL_PROVIDER=sandbox

# ---------------------------------------------------------------------
# Payment Provider (Demo Sandbox)
# ---------------------------------------------------------------------
PAYMENT_PROVIDER=sandbox
PAYMENT_DEFAULT_PROVIDER=stripe

# ---------------------------------------------------------------------
# Storage Provider (Local Ephemeral for Demo)
# ---------------------------------------------------------------------
STORAGE_PROVIDER=memory
